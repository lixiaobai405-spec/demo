# Backend
APP_NAME="Meitai AI Business Innovation Agent API"
APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:3001"
DATABASE_URL="sqlite:///./backend/data/meitai_demo.db"

# Frontend
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Password reset email (disabled by default)
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Meitai AI"
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"
PASSWORD_RESET_URL="http://localhost:3001/reset-password"

# LLM credentials -> backend/app/core/mykey.py (gitignored)
# Copy mykey.py.example and fill in real keys if you need live mode.

# RAG (disabled by default)
RAG_ENABLED="false"
CHROMA_PERSIST_DIR="./backend/data/chroma"
RAG_TOP_K="5"

# Intake Import
INTAKE_MAX_UPLOAD_SIZE_MB="10"
INTAKE_PDF_OCR_ENABLED="true"
INTAKE_PDF_OCR_MIN_TEXT_CHARS="20"
INTAKE_PDF_OCR_MAX_PAGES="12"
